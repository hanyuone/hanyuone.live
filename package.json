{
  "name": "hanyuone.live",
  "version": "0.7.2",
  "description": "A personal website written in Rust.",
  "main": "index.js",
  "scripts": {
    "dev:md": "cargo watch -w markdown/src -w blogs/md -x \"run -p markdown\"",
    "dev:site": "cd website && COMMENTS_URL=\"http://127.0.0.1:8787\" cargo leptos watch",
    "dev": "concurrently -c auto \"pnpm dev:md\" \"pnpm dev:site\"",
    "build:md": "cargo run -p markdown",
    "build:site": "cd website && cargo leptos serve --release",
    "build": "pnpm build:md && pnpm build:site"
  },
  "keywords": [],
  "author": "hanyuone",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
